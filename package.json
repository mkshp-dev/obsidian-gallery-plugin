{
  "name": "obsidian-gallery-plugin",
  "version": "2.2.7",
  "description": "Interactive image galleries for Obsidian notes using code blocks",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build-mvp": "tsc -noEmit -skipLibCheck && esbuild src/main.ts --bundle --minify --sourcemap --platform=node --external:obsidian --outfile=main.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json docs-site/versioned_docs docs-site/versioned_sidebars docs-site/versions.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "gallery",
    "images",
    "markdown"
  ],
  "author": "mkshp",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.8.0",
    "esbuild": "^0.19.4",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
