{
  "name": "obsidian-gallery-plugin",
  "version": "2.1.0",
  "description": "Interactive image galleries for Obsidian notes using code blocks",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node scripts/bump-manifest.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "gallery",
    "images",
    "markdown"
  ],
  "author": "mkshp",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.8.0",
    "esbuild": "^0.19.4",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jiti": "^2.7.0",
    "obsidian": "^1.12.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
